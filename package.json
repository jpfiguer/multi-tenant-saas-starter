{
  "name": "multi-tenant-saas-starter",
  "version": "0.1.0",
  "private": true,
  "description": "reference multi-tenant SaaS starter with Next.js + tRPC + Drizzle + Postgres",
  "license": "AGPL-3.0",
  "author": "Juan Pablo Figueroa <jpablofigueroar@gmail.com>",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
